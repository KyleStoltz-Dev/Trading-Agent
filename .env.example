# Generate a unique local password before using Docker Compose.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://trading:${POSTGRES_PASSWORD}@localhost:5432/trading_agent
DATABASE_MODE=local
DEPLOYMENT_MODE=local-single-user
# Local default: credentials go to the OS credential vault, never PostgreSQL.
BROKER_SECRET_BACKEND=keyring
# Hosted only: MODULE:ATTRIBUTE factory implementing app.services.secrets.SecretBackend.
BROKER_EXTERNAL_SECRET_BACKEND=
HOSTED_PRINCIPAL_AUTH_ENABLED=false
HOSTED_RLS_ENFORCED=false
MODEL_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_ECONOMY_MODEL=
OPENAI_BALANCED_MODEL=
OPENAI_DEEP_MODEL=
OPENAI_SAFETY_IDENTIFIER=trading-agent-local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_ECONOMY_MODEL=
ANTHROPIC_BALANCED_MODEL=
ANTHROPIC_DEEP_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOW_REMOTE=false
OLLAMA_ALLOW_INSECURE_REMOTE=false
OLLAMA_MODEL_DIGESTS=
OLLAMA_MANAGE_REMOTE_RUNTIME=false
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ECONOMY_MODEL=qwen3.5:9b
OLLAMA_BALANCED_MODEL=qwen3.5:9b
OLLAMA_DEEP_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=2m
OLLAMA_UNLOAD_ON_EXIT=true
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
RESOURCE_AWARE_MODEL_ROUTING=true
MODEL_MEMORY_RESERVE_GB=6
MODEL_MEMORY_BLOCK_PERCENT=92
MODEL_SWAP_BLOCK_PERCENT=80
OLLAMA_RUNTIME_LOCK_TIMEOUT_SECONDS=30
STARTUP_MODEL_SMOKE_TEST=true
LOCAL_SERVICE_AUTOSTART=true
POSTGRES_SERVICE_NAME=postgresql@17
AGENT_MODE=auto
MODEL_MAX_CONCURRENT_REQUESTS=2
MODEL_REQUEST_QUEUE_TIMEOUT_SECONDS=30
MODEL_HISTORY_TURN_LIMIT=20
APP_ENV=development
TRADING_WORKSPACE=legacy-local
# Optional when one account is marked as the workspace default.
TRADING_ACCOUNT=
DATABASE_AUTO_MIGRATE=true
TRADING_AGENT_API_KEY=
API_CONFIRMATION_TTL_SECONDS=60
API_REQUESTS_PER_MINUTE=120
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_MAX_DELIVERY_AGE_SECONDS=300
TRADINGVIEW_WEBHOOK_FUTURE_SKEW_SECONDS=60
TRADINGVIEW_WEBHOOK_MAX_REQUEST_BYTES=32768
TRADINGVIEW_WEBHOOK_REQUESTS_PER_MINUTE=60
TRADINGVIEW_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
EVIDENCE_DIRECTORY=.data/evidence
MAXIMUM_TRADE_RISK_PERCENT=1
# Allowed values:
# none | oanda | metatrader | ibkr | alpaca | twelve-data | ctrader (all planned)
BROKER_PROVIDER=none
# Legacy migration path only. Set BROKER_SECRET_BACKEND=legacy-env explicitly before using
# these process-global values, then migrate with `trade broker credential-rotate`.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_REQUEST_TIMEOUT_SECONDS=10
METATRADER_BRIDGE_URL=http://127.0.0.1:8765
METATRADER_BRIDGE_TOKEN=
METATRADER_ACCOUNT_ID=
METATRADER_PLATFORM=mt5
METATRADER_MODE=practice
METATRADER_REQUEST_TIMEOUT_SECONDS=10
METATRADER_POLL_INTERVAL_SECONDS=1
METATRADER_MAX_RESPONSE_BYTES=2000000
METATRADER_ALLOW_INSECURE_REMOTE=false
MARKET_QUOTE_MAX_AGE_SECONDS=5
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_REQUEST_TIMEOUT_SECONDS=10
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_REQUEST_TIMEOUT_SECONDS=10
TRADING_ECONOMICS_API_KEY=
# none | forex-factory (free calendar) | trading-economics (API key)
NEWS_PROVIDER=none
NEWS_REQUEST_TIMEOUT_SECONDS=10
NEWS_MAX_RESPONSE_BYTES=1000000
STARTUP_NEWS_SYNC=true
STARTUP_NEWS_HORIZON_DAYS=7
STARTUP_NEWS_MIN_REFRESH_MINUTES=15
PRETRADE_NEWS_WINDOW_MINUTES=120
PRETRADE_MINIMUM_EVENT_IMPORTANCE=2
WEB_FETCH_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_TEXT_CHARACTERS=30000
WEB_FETCH_ALLOWED_DOMAINS=oanda.com,tradingview.com,cmegroup.com,federalreserve.gov,fred.stlouisfed.org,bls.gov,bea.gov,dol.gov,census.gov,tradingeconomics.com
WEB_FETCH_ALLOWED_PATHS=oanda.com=/,/us-en/,/rest-live-v20/;tradingview.com=/,/support/,/symbols/;cmegroup.com=/,/education/,/markets/,/market-data/;federalreserve.gov=/,/newsevents/,/monetarypolicy/;fred.stlouisfed.org=/,/series/,/categories/,/releases/;bls.gov=/,/news.release/,/schedule/;bea.gov=/,/news/,/data/,/help/,/resources/;dol.gov=/,/newsroom/releases/;census.gov=/,/manufacturing/;tradingeconomics.com=/,/calendar/,/articles/
CHART_ALLOWED_ROOTS=
WEB_SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
DEVELOPMENT_ENABLED=false
# Required only when enabling host Codex development. This acknowledges that
# workspace-write limits writes but is not a filesystem-read/container boundary;
# Codex and child tools may read host-accessible files and staged Codex auth.
DEVELOPMENT_ACKNOWLEDGE_HOST_FILESYSTEM_READ_RISK=false
DEVELOPMENT_REPOSITORY=.
DEVELOPMENT_BASE_REF=HEAD
DEVELOPMENT_BACKEND=codex
DEVELOPMENT_APPROVAL_FLOW=scope_and_diff
DEVELOPMENT_TIMEOUT_SECONDS=1800
DEVELOPMENT_STATE_DIRECTORY=.data/development
