FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        gosu \
        iproute2 \
        ipset \
        iptables \
        jq \
        libpq-dev \
        nodejs \
        npm \
        postgresql-client \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
    && chmod u+s /usr/bin/bwrap \
    && useradd --system --no-create-home --shell /usr/sbin/nologin trading-egress \
    && usermod --append --groups vscode trading-egress \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/sudo

COPY .devcontainer/codex-install/package.json \
     .devcontainer/codex-install/package-lock.json \
     /opt/codex-install/

RUN cd /opt/codex-install \
    && npm ci --omit=dev \
    && ln -s /opt/codex-install/node_modules/.bin/codex /usr/local/bin/codex

COPY pyproject.toml uv.lock README.md /opt/trading-agent-dependencies/

ENV UV_CACHE_DIR=/opt/uv-cache

RUN cd /opt/trading-agent-dependencies \
    && uv sync --locked --no-install-project --extra dev --extra ai --extra metatrader \
       --group release \
    && rm -rf /opt/trading-agent-dependencies/.venv \
    && chmod -R a+rX /opt/uv-cache

COPY .devcontainer/init-firewall.sh /usr/local/bin/trading-agent-init-firewall
COPY .devcontainer/post-create.sh /usr/local/bin/trading-agent-post-create
COPY .devcontainer/container-entrypoint.sh /usr/local/bin/trading-agent-container-entrypoint
COPY .devcontainer/responses-api-proxy.py /usr/local/libexec/trading-agent-responses-api-proxy
COPY .devcontainer/configure-codex-proxy.py /usr/local/bin/trading-agent-configure-codex-proxy

RUN chmod 500 /usr/local/bin/trading-agent-init-firewall \
    && chmod 500 /usr/local/bin/trading-agent-container-entrypoint \
    && chmod 755 /usr/local/bin/trading-agent-post-create \
    && chmod 555 /usr/local/libexec/trading-agent-responses-api-proxy \
    && chmod 555 /usr/local/bin/trading-agent-configure-codex-proxy

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV GIT_CONFIG_NOSYSTEM=1
ENV CODEX_HOME=/tmp/trading-agent-codex-home

ENTRYPOINT ["/usr/local/bin/trading-agent-container-entrypoint"]
CMD ["sleep", "infinity"]
