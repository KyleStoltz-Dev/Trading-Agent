{
  "name": "wyckoff-smc-fractal-v1",
  "status": "hypothesis",
  "minimum_sample": 30,
  "principles": [
    "Anything can happen.",
    "Risk is defined and accepted before entry.",
    "Facts, hypotheses, and outcomes are recorded separately."
  ],
  "context": {
    "required": [
      "instrument",
      "market_time_with_timezone",
      "venue",
      "context_timeframe",
      "trigger_timeframe",
      "session",
      "regime",
      "nearest_high_impact_event_minutes"
    ],
    "regime_values": [
      "trend",
      "range",
      "expansion",
      "compression",
      "transition",
      "unclear"
    ]
  },
  "operational_definitions": {
    "equal_highs_or_lows": {
      "fact": "Two or more swing prices fall within a declared tolerance.",
      "parameters": ["swing_lookback", "tolerance_ticks", "minimum_touches"]
    },
    "liquidity_sweep": {
      "fact": "Price trades beyond a declared reference extreme.",
      "confirmation": "A trigger-timeframe close returns through the reference within max_reclaim_bars.",
      "parameters": ["reference_id", "minimum_penetration_ticks", "max_reclaim_bars"]
    },
    "break_of_structure": {
      "fact": "A candle body closes beyond a predeclared protected swing.",
      "parameters": ["protected_swing_id", "minimum_close_distance_ticks"]
    },
    "fair_value_gap": {
      "fact": "In a three-candle sequence, candle one and candle three wicks do not overlap.",
      "parameters": ["minimum_gap_ticks", "minimum_displacement_atr"]
    },
    "poi_mitigation": {
      "fact": "Price revisits the declared origin range after displacement.",
      "parameters": ["poi_low", "poi_high", "maximum_prior_touches"]
    },
    "accumulation_or_distribution": {
      "classification": "hypothesis",
      "requires": ["declared_range", "event_sequence", "invalidation_condition"]
    },
    "range_location_80_percent": {
      "fact": "For low L and high H, bullish location=(H-price)/(H-L); bearish location=(price-L)/(H-L).",
      "threshold": 0.8
    }
  },
  "entry_gate": {
    "all_required": [
      "risk_within_limit",
      "invalidation_declared",
      "broker_contract_loaded",
      "news_proximity_known",
      "context_hypothesis_recorded",
      "trigger_confirmation_recorded"
    ]
  },
  "management": {
    "predeclare": [
      "partial_targets",
      "runner_condition",
      "stop_change_condition",
      "time_stop",
      "hedge_is_separate_trade_thesis"
    ]
  },
  "review": {
    "required": [
      "realized_r",
      "mfe_r",
      "mae_r",
      "fees",
      "slippage",
      "process_score",
      "outcome_score",
      "rule_evaluations"
    ],
    "segment_by": [
      "setup",
      "instrument",
      "regime",
      "context_timeframe",
      "trigger_timeframe",
      "session",
      "playbook_version",
      "news_proximity"
    ]
  }
}
